                      },
                      "spec": {
                        "dataset": "traffic",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    CASE intensity\n        WHEN 'trace'    THEN 1\n        WHEN 'light'    THEN 2\n        WHEN 'moderate' THEN 3\n        WHEN 'heavy'    THEN 4\n    END AS intensity_order,\n    intensity,\n    MAX(median_rel) FILTER (WHERE precipitation_type = 'rain') AS rain,\n    MAX(median_rel) FILTER (WHERE precipitation_type = 'snow') AS snow\nFROM driving_behavior \nWHERE precipitation_type IN ('rain', 'snow')\nGROUP BY intensity\nORDER BY intensity_order;",
                        "sql": {
